# ==============================================================================
# AI-Powered Stock Portfolio Tool - Environment Configuration
# ==============================================================================

# Backend Server Configuration
PORT=8000
ENVIRONMENT=development

# Security & Authentication
# IMPORTANT: Change SECRET_KEY to a strong random key in production (e.g., via `openssl rand -hex 32`)
SECRET_KEY=supersecretkey_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration
# SQLite connection string (e.g., sqlite:///./trading.db)
# For production PostgreSQL: postgresql://user:password@localhost:5432/trading
DATABASE_URL=sqlite:///./trading.db

# External API Integrations
NEWSAPI_KEY=your_newsapi_key_here

# System & Refresh Intervals
REFRESH_INTERVAL_MINUTES=15
RECOMMENDATION_REFRESH_HOURS=2

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8000/v1
